PORT=5001
# Generate a unique random value for each deployment; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret-before-starting
# Leave these empty for the local JSON demo store.
# Run supabase/migrations/20261102000000_skilltern_documents.sql in the Supabase SQL Editor,
# then set SUPABASE_URL and a server-side Supabase Secret key before starting the API.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
